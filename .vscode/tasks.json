{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Raylib Project",
            "type": "shell",
            "command": "C:/mingw64/bin/g++",  // Path to MinGW g++ compiler
            "args": [
                "wfc.cpp",                        // Your source file (replace with your actual file)
                "Tile.cpp",
                "Grid.cpp",
                "-o", "wfc.exe",                   // Output executable file
                "-I", "C:/raylib/include",         // Path to Raylib headers
                "-L", "C:/raylib/lib",             // Path to Raylib libraries
                "-lraylib",                        // Link Raylib static library
                "-lopengl32",                      // Link OpenGL
                "-lgdi32",                         // Link GDI
                "-lwinmm"                          // Link Windows Multimedia
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
